<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>一码 OneVerifyCode</title>
    <organization>com.oneverifycode</organization>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="13.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default">
            <line choice="com.oneverifycode.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.oneverifycode.pkg" visible="false">
        <pkg-ref id="com.oneverifycode.pkg"/>
    </choice>
    <pkg-ref id="com.oneverifycode.pkg" version="0.5.3" onConclusion="none">OneVerifyCode-component.pkg</pkg-ref>
</installer-gui-script>
